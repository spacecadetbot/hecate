# Copy to .env and edit. Every setting is optional except the sign-in one.

# --- Sign in ---------------------------------------------------------------
# Your iOS/macOS app's bundle ID (comma-separate several). Required for Sign in with Apple.
HECATE_APPLE_BUNDLE_ID=
# While developing, lets you sign in without Apple: POST /v1/auth/dev {"name":"owen"}. Turn OFF afterwards.
HECATE_DEV_LOGIN=0
# 1 = anyone who can reach the server may create an account (no invite code). Can also be changed in admin settings.
HECATE_OPEN_SIGNUP=0

# --- Network & storage -------------------------------------------------------
HECATE_HOST=0.0.0.0
HECATE_PORT=8080
HECATE_DATA_DIR=./data
HECATE_LOG_LEVEL=info

# --- Limits --------------------------------------------------------------------
HECATE_MAX_UPLOAD_MB=2048
# Largest video sent natively to a model that accepts video (bigger ones are sampled into frames instead).
HECATE_NATIVE_VIDEO_MAX_MB=96
# Frame sampling for models without video input: one frame every N seconds, at most M frames.
HECATE_VIDEO_FRAME_EVERY_SEC=4
HECATE_VIDEO_MAX_FRAMES=16
# Rough size of the conversation history sent to the model (characters).
HECATE_CONTEXT_CHARS=48000
HECATE_MAX_RUNS_PER_USER=4

# --- Timeouts (milliseconds) --------------------------------------------------------
# Generous first-token timeout because the first request can make LM Studio load a model.
HECATE_FIRST_TOKEN_TIMEOUT_MS=180000
HECATE_IDLE_TIMEOUT_MS=90000
HECATE_HEALTH_INTERVAL_MS=15000
HECATE_HEALTH_TIMEOUT_MS=4000

# --- Tokens ------------------------------------------------------------------------------
HECATE_ACCESS_TTL_SEC=900
HECATE_REFRESH_TTL_DAYS=90
